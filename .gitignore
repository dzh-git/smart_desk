.env
.env.*
!.env.example
!.env.sample
!.env.template
config/smartdesk.integration.json
config/*device-tokens*.json
!config/*.example.json
*.jks
*.keystore
*.p12
*.pfx
*.private.key
*.private.pem
keystore.properties
**/google-services.json
esp32_seat_controller/firmware/include/DeviceConfig.h

