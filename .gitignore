# SmartDesk monorepo ignore rules.
# Unanchored rules apply to every module; generated files that are intentionally
# versioned must be re-included explicitly with a leading `!`.

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

.pytest_cache/
.pytest_tmp/
.pytest-tmp-*/
.hypothesis/
.tox/
.nox/

.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/

.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ---------- Python Build ----------
build/
dist/
*.egg
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# ---------- Virtual Env ----------
.venv/
venv/
env/
.tools/

# ---------- Database ----------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

